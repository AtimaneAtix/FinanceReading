# syntax=docker/dockerfile:1

# The hunter renders JavaScript listing pages, so it needs a real browser.
# It is a separate image because Chromium adds several hundred megabytes that
# the web and worker services have no use for.
FROM node:22-slim AS hunter
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund

# Installs the browser build this Playwright version expects, plus its system
# libraries. Kept in one layer so a rebuild does not re-download it.
RUN npx playwright install --with-deps chromium

COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
COPY tests ./tests
COPY config ./config

ENV DB_PATH=/app/data/feeds.db
ENTRYPOINT ["npm", "run", "discover", "--"]
